{
  "serviceArn": "arn:aws:ecs:us-east-2:422799216424:service/Solution-Hub/Solution-Hub",
  "executionRoleArn": "arn:aws:iam::422799216424:role/ecsTaskExecutionRole",
  "healthCheckPath": "/healthz",
  "cpu": "1024",
  "memory": "2048",
  "primaryContainer": {
    "image": "422799216424.dkr.ecr.us-east-2.amazonaws.com/solution-hub:latest",
    "containerPort": 8080,
    "environment": [
      { "name": "AWS_REGION", "value": "us-east-2" },
      { "name": "TRUST_PROXY_HEADERS", "value": "1" },
      { "name": "SOLUTIONS_HUB_SHEET_ID", "value": "1sR1CTeznF4-8Az3WhGwgaAI4eMD6JEfAUhzgVpEvRSs" },
      { "name": "SOLUTIONS_HUB_SHEET_GID", "value": "439459761" },
      { "name": "SOLUTIONS_HUB_DATA_RANGE", "value": "AI2:AK" },
      { "name": "SOLUTIONS_HUB_COLUMN_FIELDS", "value": "status,department,problem" }
    ],
    "awsLogsConfiguration": {
      "logGroup": "/ecs/Solution-Hub",
      "logStreamPrefix": "ecs"
    }
  },
  "scalingTarget": {
    "minTaskCount": 1,
    "maxTaskCount": 3
  }
