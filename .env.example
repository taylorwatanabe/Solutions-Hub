# Local Solutions Hub (never commit .env).

PORT=8080
TRUST_PROXY_HEADERS=1

# --- Local demo without Google Sheets (no GCP credentials) ---
ALLOW_LOCAL_DATA_STORAGE=1
# DATA_STORAGE=local
# SOLUTIONS_HUB_LOCAL_DATA=data/submissions.json

# --- Friction-to-Solutions replies sheet (AI–AK from row 2) ---
SOLUTIONS_HUB_SHEET_ID=1sR1CTeznF4-8Az3WhGwgaAI4eMD6JEfAUhzgVpEvRSs
SOLUTIONS_HUB_SHEET_GID=439459761
SOLUTIONS_HUB_DATA_RANGE=AI2:AK
# Map AI, AJ, AK → app fields (change if your headers differ):
SOLUTIONS_HUB_COLUMN_FIELDS=status,department,problem
# Optional: set tab title instead of resolving by gid
# SOLUTIONS_HUB_SHEET_TAB=

# AWS_REGION=us-east-2

# Reuse the same GCP service account secret as QC Dashboard / CAT-2 environment.
# Prefer ECS task Secret injection into AWS_GCP_SERVICE_ACCOUNT_SECRET_ID (plaintext JSON at runtime).
# AWS_GCP_SERVICE_ACCOUNT_SECRET_ID=name-or-arn-of-existing-qc-gcp-sa-secret
# Or paste JSON locally (do not commit):
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or file path:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\sa.json

# Share the sheet with the service account client_email (Editor).
# When GCP credentials are set, Sheets is used (ALLOW_LOCAL_DATA_STORAGE is ignored).
